FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd -r vanessa && useradd -r -g vanessa -d /app vanessa

COPY deploy/docker/engine_server.py /app/engine_server.py

USER vanessa

EXPOSE 8899

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8899/ui/vrm/index.html')" || exit 1

ENTRYPOINT ["python3", "-u", "/app/engine_server.py", "8899", "/app"]
